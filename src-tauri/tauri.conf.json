{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Hopper",
  "version": "1.0.0",
  "identifier": "com.screenhopper.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One mouse, keyboard and clipboard across every computer on your desk.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-screenhopper-uinput.rules": "linux/70-screenhopper-uinput.rules",
          "/usr/lib/modules-load.d/screenhopper-uinput.conf": "linux/uinput.conf"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    }
  }
}
